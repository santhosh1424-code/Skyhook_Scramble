{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@shared/*": ["./shared/*"],
      "@client/*": ["./client/src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["client/src/**/*.ts", "shared/**/*.ts"]
}
